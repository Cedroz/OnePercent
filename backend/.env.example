# Template of the env vars the backend needs. Safe to commit (placeholders only).
# Copy this to `.env` and fill in real values (get them from your GitHub OAuth App).
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
# Random signing key for the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=any_long_random_string
# Neon Postgres connection string (copy from the Neon dashboard).
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require
# Key for encrypting stored tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_generated_fernet_key
